{
  "name": "frontend-performance-lab-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @riguran/frontend-performance-lab dev",
    "build": "pnpm -r --if-present build",
    "benchmark": "pnpm --filter @riguran/frontend-performance-lab benchmark && node scripts/write-benchmark-report.mjs",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:unit": "pnpm -r --if-present test:unit && node --test scripts/*.test.mjs",
    "test:e2e": "pnpm --filter @riguran/frontend-performance-lab test:e2e",
    "pack:check": "node scripts/verify-package.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0"
  }
}
