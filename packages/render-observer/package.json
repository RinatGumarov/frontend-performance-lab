{
  "name": "@riguran/render-observer",
  "version": "0.1.0",
  "description": "Typed structural rendering metrics with a framework-free core and React adapters.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rinatgumarov/frontend-performance-lab.git",
    "directory": "packages/render-observer"
  },
  "homepage": "https://github.com/rinatgumarov/frontend-performance-lab/tree/main/packages/render-observer#readme",
  "bugs": {
    "url": "https://github.com/rinatgumarov/frontend-performance-lab/issues"
  },
  "keywords": [
    "performance",
    "react",
    "profiler",
    "rendering",
    "instrumentation"
  ],
  "author": "Rinat",
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
